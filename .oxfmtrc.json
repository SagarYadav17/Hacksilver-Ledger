{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "node_modules/**",
    ".expo/**",
    ".codex/**",
    "dist/**",
    "android/**",
    "ios/**",
    "docs/**",
    "design_handoff_hacksilver_redesign/**",
    "*.md",
    "mise.toml"
  ]
}
